</main>

<script>
    function Validation() {
    var priceInput = document.getElementById('price');
    var discountPrice = document.getElementById('discountprice');
    var discountpriceMsg = document.getElementById('priceAlert'); 
    var categoryOffer = document.getElementById('catOffer'); 

    // Ensure that a discount price can be set only if the category offer is 0
    function offerValidation() {
        var catOfferValue = categoryOffer.options[categoryOffer.selectedIndex].text.trim(); // Get the text (category offer)
        var catValue = parseFloat(catOfferValue) || 0; // Convert category offer to a number

        console.log("Category Offer Value:", catValue); // Log for debugging

        // Block discount price if category offer is greater than 0
        if (catValue > 0) {
            discountpriceMsg.textContent = "Category offer exists. Discount price cannot be set.";
            return false; // Prevent form submission if category offer > 0
        } else {
            discountpriceMsg.textContent = ""; // Clear any error message if category offer is 0
            return true; // Allow submission
        }
    }

    // Validate the discount price value
    function validateDiscountAmount() {
        var price = parseFloat(priceInput.value) || 0; // Convert price to a number
        var discountprice = parseFloat(discountPrice.value) || 0; // Convert discount price to a number

        console.log("Price:", price, "Discount Price:", discountprice); // Log for debugging

        // Validate discount price: it should not be more than price and should be positive
        if (isNaN(discountprice) || discountprice < 0) {
            discountpriceMsg.textContent = "Invalid discount amount";
            return false;
        } else if (discountprice >= price) {
            discountpriceMsg.textContent = "Discount amount cannot exceed price";
            return false;
        } else {
            discountpriceMsg.textContent = ""; // Clear the message if validation passes
            return true;
        }
    }

    // Handle form submission validation
    function handleSubmit(event) {
        // Perform both validations and prevent submission if either fails
        if (!validateDiscountAmount() || !offerValidation()) {
            console.log("Validation failed. Form submission prevented."); // Log for debugging
            event.preventDefault(); // Stop form submission if validation fails
        } else {
            console.log("Validation passed. Form will be submitted."); // Log for debugging
        }
    }

    // Attach the validation check to the form submission event
    document.querySelector('.form-add-product').addEventListener('submit', handleSubmit);
}

// Initialize validation when the script loads
Validation();

</script>





