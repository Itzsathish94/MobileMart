    <section class="content-main">
        <div class="row">
            <div class="col-9">
                <div class="content-header">
                    <h2 class="content-title"> Add Product Offer</h2>

                </div>
            </div>
            <div class="col-lg-12">
                <div class="card mb-4">
                    <div class="card-header">

                    </div>
                    <div class="card-body">
                        <form method="post" class="form-add-product" action="/admin/update_product/{{product._id}}"
                            enctype="multipart/form-data" onsubmit="return Validation()">
                            <div class="mb-4">
                                <label for="product_name" class="form-label">Product Name</label>
                                <input type="text" value="{{product.name}}" placeholder="Type here" name="name"
                                    class="form-control" id="productName" disabled>
                                <h6 class="alertAddProduct mt-1" style="color: red" id="productNameAlert"></h6>

                            </div>
                            <div class="mb-4">
                                <label class="form-label">Full description</label>

                                <input class="form-control" id="longdescription" name="description" rows="3"
                                    value="{{product.description}}" disabled></input>
                            </div>
                            <div class="row">
                                <div class="col-lg-2">
                                    <div class="mb-4">
                                        <label class="form-label">Price</label>
                                        <div class="row gx-2">
                                            <input placeholder="$" type="text" value="{{product.price}}" id="price"
                                                disabled name="price" class="form-control">
                                        </div>
                                    </div>
                                </div>

                                <div class="col-lg-2">
                                    <div class="mb-4">
                                        <label class="form-label" style="font-size: larger;font-weight: 900;">Enter
                                            Discount Price *</label>
                                        <div class="row gx-2">
                                            <input placeholder="$" type="number" value="{{product.discountprice}}"
                                                id="discountprice" name="discountprice" class="form-control" required>
                                        </div>
                                        <h6 class="alertAddProduct mt-1" style="color: red" id="priceAlert"></h6>


                                    </div>
                                </div>
                                <div class="col-lg-2">
                                    <div class="mb-4">
                                        <label class="form-label">Stock</label>
                                        <input name="stock" value="{{product.stock}}" class="form-control" disabled
                                            placeholder="Quantity" type="text" id="Qty">
                                    </div>
                                </div>
                                <div class="col-lg-4">
                                    <label class="form-label">Category:</label>
                                    <select name="category" id="category" class="form-select" disabled>
                                        <option value="{{product.category._id}}" selected>{{product.category.category}}
                                        </option>
                                        {{!-- <option value="" disabled selected hidden>Select a category</option> --}}
                                        {{#each category}}
                                        {{#if (Noteq this.category ../product.category.category)}}
                                        <option value="{{this._id}}">{{this.category}}</option>
                                        {{/if}}
                                        {{/each}}
                                    </select>
                                </div>
                                <div class="col-lg-2">
                                    <label class="form-label">Brands:</label>
                                    <select name="brand" id="brand" class="form-select" disabled>
                                        {{!-- <option value="" disabled selected hidden>Select a Brand</option> --}}
                                        <option value="{{product.brand._id}}" selected>{{product.brand.brand}}
                                        </option>
                                        {{#each brandData}}
                                        {{#if (Noteq this.brand ../product.brand.brand)}}
                                        <option value="{{this._id}}">{{this.brand}}</option>
                                        {{/if}}
                                        {{/each}}
                                    </select>
                                </div>

                            </div>
                            <div class="form-group">
                                <label for="productImage">Product Image:</label>
                                <div class="d-flex border p-10 m-tb-10">
                                    <input name="product-id" type="hidden" value="{{product._id}}" disabled>
                                    {{#each product.image}}
                                    <div class="image-container">
                                        <div class="badge rounded-pill alert-danger ">
                                            <p class="close-button" data-image-index="{{@index}}"
                                                style="text-decoration: none;">×</p>
                                        </div>
                                        <img src="/images/products/{{this}}" alt="images" disabled
                                            style="width: 80px; height: auto;" class="m-2 pro-image"
                                            data-image-index="{{@index}}">
                                    </div>

                                    {{/each}}
                                </div>
                                <input type="file" class="form-control-file" id="productImage" multiple name="image">
                            </div>

                            <div class="d-flex g-2">
                                <div class="m-2">
                                    <button type="submit" class="btn btn-primary">Save Product</button>

                                </div>
                                <div class="m-2">
                                    <a id="backButton" type="button" class="btn btn-primary">back</a>

                                </div>
                                <div class="col-lg-4" hidden>
                                    <label class="form-label">Category:</label>
                                    <select name="categoryOffer" id="catOffer" class="form-select">


                                        {{!-- <option value="" disabled selected hidden>Select a category</option> --}}
                                        {{#each category}}
                                        {{#if (eq this.category ../product.category.category)}}
                                        <option value="{{this._id}}" >{{this.categoryOffer}}</option>
                                        {{/if}}
                                        {{/each}}
                                    </select>
                                </div>





                            </div>

                        </form>
                    </div>
                </div> <!-- card end// -->



            </div>
    </section> <!-- content-main end// -->
