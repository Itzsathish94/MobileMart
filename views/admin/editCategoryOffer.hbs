<main class="main-wrap">
    <header class="main-header navbar">
        <!-- Header content -->
    </header>
    <section class="content-main">
        <div class="content-header">
            <div>
                <h2 class="content-title card-title">Add Category Offer </h2>
                {{!-- <p>Add a category</p> --}}
            </div>
            
        </div>
        <div class="card">
            <div class="card-body">
                
                <div class="row">
                    <div class="col-md-12">
                        <form action="/admin/editCategoryOffer/{{cat._id}}" method="post" class=""  id="categoryForm">
                            <div class="mb-4">
                                <label for="categoryName" class="form-label">Category Name:</label>
                                <input type="text" placeholder="Type here" class="form-control" disabled name="catOffer" value="{{cat.category}}" id="categoryName"/>
                                <div id="categoryNameAlert" class="text-danger mt-1"></div>
                            </div>
                            <div class="mb-4"></div>
                                <label for="categoryOffer" class="form-label">Category Offer:</label>
                                <input type="text" placeholder="Type here" class="form-control" name="categoryOffer" id="categoryOffer" required />
                                <div id="categoryOfferAlert" class="text-danger mt-1"></div>
                            </div>
            
                            <div>
                                <div class="col-md-12">
                                <button type="submit" class="btn btn-primary">Create category</button>
                                <a id="backbutton" type="button" class="btn btn-primary">Back</a>
                            </div>
                            </div>
                            
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <footer class="main-footer font-xs">
        <!-- Footer content -->
    </footer>
</main>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>

<script>
    // Validation function for the category offer input
    function validateCategoryForm() {
        const categoryOffer = document.getElementById("categoryOffer").value.trim();
        const categoryOfferAlert = document.getElementById("categoryOfferAlert");
        categoryOfferAlert.innerHTML = "";
        const categoryOfferPattern = /^(99|[1-9][0-9]?)$/; // Ensures only numbers from 1 to 100

        if (!categoryOfferPattern.test(categoryOffer)) {
            categoryOfferAlert.innerHTML = "Category offer must be a valid number between 1 and 100.";
            return false;
        }
        return true;
    }

    // Add event listener to form submission with SweetAlert confirmation
    document.getElementById("categoryForm").addEventListener("submit", function(event) {
        event.preventDefault(); // Prevent form submission

        // Validate the form first
        if (!validateCategoryForm()) {
            return;
        }

        // SweetAlert confirmation for deleting product offers and updating category offer
        Swal.fire({
            title: "Are you sure?",
            text: "Setting this category offer will remove all existing product offers in this category.",
            icon: "warning",
            showCancelButton: true,
            confirmButtonColor: "#088178",
            cancelButtonColor: "#d33",
            confirmButtonText: "Yes, update offer!",
            cancelButtonText: "Cancel"
        }).then((result) => {
            if (result.isConfirmed) {
                // If confirmed, submit the form
                document.getElementById("categoryForm").submit();
            }
        });
    });

    // Back button confirmation with SweetAlert
    $(document).ready(function() {
        $('#backbutton').click(function(e) {
            e.preventDefault();

            Swal.fire({
                title: "Leave the page?",
                text: "The data will not be saved.",
                icon: "warning",
                showCancelButton: true,
                confirmButtonColor: "#088178",
                cancelButtonColor: "#d33",
                confirmButtonText: "Yes"
            }).then((result) => {
                if (result.isConfirmed) {
                    window.location.href = "/admin/category";
                }
            });
        });
    });
</script>

