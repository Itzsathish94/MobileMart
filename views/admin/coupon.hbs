<!-- Include jQuery -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<!-- Include SweetAlert -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
    ////////////delete Coupon
    $(document).ready(function () {
        $(document).on('click', '#blockcoupon', function (e) {
            e.preventDefault();
            var id = $(this).data('coupon-id');
            var $this = $(this);

            Swal.fire({
                title: "Are you sure?",
                text: "You want to block this coupon?",
                icon: "warning",
                showCancelButton: true,
                confirmButtonColor: "#088178",
                cancelButtonColor: "#d33",
                confirmButtonText: "Yes"
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        type: 'DELETE',
                        url: '/admin/delete_coupon',
                        contentType: 'application/json',
                        data: JSON.stringify({ id: id }),
                        success: function (productData) {
                            $this.closest('tr').remove(); // Use $this instead of $(this)                               
                        },
                        error: function (xhr, status, error) {
                            console.error("Error removing product from wishlist:", error);
                            swal("Error", "Something went wrong. Please try again later.", "error");
                        }
                    });
                    Swal.fire({
                        title: "Blocked!",
                        text: "Coupon blocked Succesfully!",
                        icon: "success"
                    }).then(() => window.location.reload());
                }
            });


        });
    });



        $(document).ready(function () {
        $(document).on('click', '#unblockcoupon', function (e) {
            e.preventDefault();
            var id = $(this).data('coupon-id');
            var $this = $(this);

            Swal.fire({
                title: "Are you sure?",
                text: "You want to unblock this coupon",
                icon: "warning",
                showCancelButton: true,
                confirmButtonColor: "#088178",
                cancelButtonColor: "#d33",
                confirmButtonText: "Yes"
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        type: 'DELETE',
                        url: '/admin/delete_coupon',
                        contentType: 'application/json',
                        data: JSON.stringify({ id: id }),
                        success: function (productData) {
                            $this.closest('tr').remove(); // Use $this instead of $(this)                               
                        },
                        error: function (xhr, status, error) {
                            console.error("Error removing product from wishlist:", error);
                            swal("Error", "Something went wrong. Please try again later.", "error");
                        }
                    });
                    Swal.fire({
                        title: "Unblocked!",
                        text: "Coupon unblocked Succesfully!",
                        icon: "success"
                    }).then(() => window.location.reload());
                }
            });


        });
    });

    
</script>