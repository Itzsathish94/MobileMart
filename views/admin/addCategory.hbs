<main class="main-wrap">
    <header class="main-header navbar">
        <!-- Header content -->
    </header>
    <section class="content-main">
        <div class="content-header">
            <div>
                <h2 class="content-title card-title">Add Categories </h2>
                <p>Add a category</p>
            </div>
            
        </div>
        <div class="card">
            <div class="card-body">
                {{#if catSaveMsg}}
                <div class="alert alert-success mt-3 alert-dismissible fade show" role="alert">
                    {{catSaveMsg}}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
                {{/if}}
                {{#if catExistMsg}}
                <div class="alert alert-danger mt-3 alert-dismissible fade show" role="alert">
                    {{catExistMsg}}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
                {{/if}}
                <div class="row">
                    <div class="col-md-12">
                        <form action="/admin/addCategory" method="post" class="" enctype="multipart/form-data" id="categoryForm">
                            <div class="mb-4">
                                <label for="categoryName" class="form-label">Category Name:</label>
                                <input type="text" placeholder="Type here" class="form-control" name="name" id="categoryName" required />
                                <div id="categoryNameAlert" class="text-danger mt-1"></div>
                            </div>
                            <div class="mb-4">
                                <label for="categoryImage" class="form-label">Category Image:</label>
                                <input type="file" class="form-control-file" name="image" id="categoryImage" required />
                                <div id="categoryImageAlert" class="text-danger mt-1"></div>
                            </div>
                            <div>
                                <div class="col-md-12">
                                <button type="submit" class="btn btn-primary">Create category</button>
                                <a id="backbutton" type="button" class="btn btn-primary">Back</a>
                            </div>
                            </div>
                            
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <footer class="main-footer font-xs">
        <!-- Footer content -->
    </footer>
</main>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>
<script>
    function validateCategoryForm() {
        const categoryName = document.getElementById("categoryName").value.trim();
        const categoryImage = document.getElementById("categoryImage").files.length;
        const categoryNameAlert = document.getElementById("categoryNameAlert");
        const categoryImageAlert = document.getElementById("categoryImageAlert");

        // Reset alerts
        categoryNameAlert.innerHTML = "";
        categoryImageAlert.innerHTML = "";

        // Category Name validation
        const categoryNamePattern = /^[a-zA-Z\s]{3,30}$/; // Allows only letters and spaces, length 3-30

        if (!categoryNamePattern.test(categoryName)) {
            categoryNameAlert.innerHTML = "Category name must be atleast 3 characters.";
            return false;
        }

        // Category Image validation
        if (categoryImage === 0) {
            categoryImageAlert.innerHTML = "Please select an image for the category.";
            return false;
        }

        return true;
    }

    document.getElementById("categoryForm").addEventListener("submit", function (event) {
        if (!validateCategoryForm()) {
            event.preventDefault();
        }
    });

    // Back button confirmation with SweetAlert
    $(document).ready(function () {
        $('#backbutton').click(function (e) {
            e.preventDefault();

            Swal.fire({
                title: "Leave the page?",
                text: "The data will not be saved.",
                icon: "warning",
                showCancelButton: true,
                confirmButtonColor: "#088178",
                cancelButtonColor: "#d33",
                confirmButtonText: "Yes"
            }).then((result) => {
                if (result.isConfirmed) {
                    window.location.href = "/admin/category";
                }
            });
        });
    });
</script>
